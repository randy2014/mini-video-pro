<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发现新版本"
        android:textSize="18sp"
        android:textColor="#191919"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlg_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0"
        android:textSize="24sp"
        android:textColor="#07C160"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/dlg_notes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="更新说明"
        android:textSize="15sp"
        android:textColor="#888888"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:layout_marginTop="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="26dp">

        <TextView
            android:id="@+id/dlg_later"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="稍后"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/dlg_update"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:text="立即更新"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_button_gold"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
