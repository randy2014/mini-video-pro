<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <!-- 品牌头部 -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="48dp"
            android:contentDescription="迷你视频应用图标"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="迷你视频"
            android:textSize="30sp"
            android:textColor="#191919"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VIP 视频权益"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="32dp" />

        <!-- 账号 -->
        <EditText
            android:id="@+id/et_account"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="输入账号 (手机号)"
            android:textColor="#191919"
            android:textColorHint="#B2B2B2"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="phone"
            android:singleLine="true"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <!-- 密码（带可见切换） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="14dp">

            <EditText
                android:id="@+id/et_password"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="输入密码"
                android:textColor="#191919"
                android:textColorHint="#B2B2B2"
                android:background="@null"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/toggle_pwd"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:text="👁"
                android:textSize="18sp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- 权益码（必填） -->
        <EditText
            android:id="@+id/et_entitlement_code"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="输入权益码 (8位数字，必填)"
            android:textColor="#191919"
            android:textColorHint="#B2B2B2"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="number"
            android:singleLine="true"
            android:maxLength="8"
            android:textSize="16sp"
            android:layout_marginBottom="14dp" />

        <!-- 图形验证码 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <EditText
                android:id="@+id/et_captcha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="图形验证码"
                android:textColor="#191919"
                android:textColorHint="#B2B2B2"
                android:background="@drawable/bg_input"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:singleLine="true"
                android:maxLength="6"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/iv_captcha"
                android:layout_width="110dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:contentDescription="验证码"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <!-- 登录按钮 -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="登录 / 注册"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:background="@drawable/bg_button_gold"
            android:minHeight="56dp"
            android:stateListAnimator="@null"
            android:layout_marginBottom="18dp" />

        <!-- 提示 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="账号不存在时将自动注册"
            android:textSize="12sp"
            android:textColor="#B2B2B2" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tv_login_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#B2B2B2"
            android:layout_marginTop="24dp"
            android:text="v1.0" />

    </LinearLayout>
</ScrollView>
